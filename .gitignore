# ==============================================================================
# Git Ignore Configuration: Real-Time CDC & Streaming Platform
# ==============================================================================

# Environment & Sensitive Secrets (Never commit credentials to GitHub)
.env
*.env.local

# Python Bytecode, Caches & Builds
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
tmp_benchmarks/

# Spark / Hadoop / Checkpoints / Metastore
checkpoint/
checkpoints/
.checkpoint/
metastore_db/
derby.log
spark-warehouse/
/tmp/spark-checkpoints/

# Apache Airflow Local Execution Artifacts
airflow.cfg
airflow.db
webserver_config.py
logs/
airflow_logs/
standalone_admin_password.txt

# Local Data Lake Storage (Preserve folder structure via .gitkeep, ignore generated datasets)
data/batch/*
!data/batch/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
data/errors/*
!data/errors/.gitkeep

# DuckDB Local Storage
*.duckdb
*.duckdb.wal

# General Logs
*.log

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
